[*.cs]

; CS1591 : Missing XML comment for publicly visible type or member 'xxx'
dotnet_diagnostic.CS1591.severity = none

; CA1822: Member 'xxx' does not access instance data and can be marked as static
dotnet_diagnostic.CA1822.severity = silent

; CA1805: Member 'xxx' is explicitly initialized to its default value
dotnet_diagnostic.CA1805.severity = none

; CA1848 – Use the LoggerMessage delegates.
dotnet_diagnostic.CA1848.severity = silent

; CA1707 – Identifiers should not contain underscores.
dotnet_diagnostic.CA1707.severity = none