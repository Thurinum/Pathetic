<Project>

  <PropertyGroup>
    <SlangOutDir Condition="'$(SlangOutDir)' == ''">$(BaseIntermediateOutputPath)slang</SlangOutDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(SlangShadersDir)' != ''">
    <SlangSearchDir Include="$(SlangSearchDirs)" Condition="'$(SlangSearchDirs)' != ''" />
    <SlangGenerated Include="@(SlangShader->'$(SlangOutDir)/gen/%(Filename).g.cs')" />
    <Compile Include="@(SlangGenerated)" Link="Generated/%(Filename).g.cs" Visible="false" />
    <SlangInput Include="@(SlangShader)" />
    <SlangInput Include="$(SlangShadersDir)/**/*.slangh" />
  </ItemGroup>

  <Target Name="CollectSlangInputs" Condition="'$(SlangShadersDir)' != ''">
    <CreateItem Include="@(SlangSearchDir->'%(FullPath)/**/*.slang')">
      <Output TaskParameter="Include" ItemName="SlangInput" />
    </CreateItem>
    <CreateItem Include="@(SlangSearchDir->'%(FullPath)/**/*.slangh')">
      <Output TaskParameter="Include" ItemName="SlangInput" />
    </CreateItem>
  </Target>

  <Target Name="ResolveSlangTool"
          Condition="'$(SlangShadersDir)' != ''"
          DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Pathetic.Slang.Tool/Pathetic.Slang.Tool.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_SlangTool" />
    </MSBuild>
  </Target>

  <Target Name="GenerateSlangAssets"
          Condition="'$(SlangShadersDir)' != ''"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveSlangTool;CollectSlangInputs"
          Inputs="@(SlangInput);@(_SlangTool)"
          Outputs="$(SlangOutDir)/.stamp">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(_SlangTool)&quot; --shaders &quot;$(SlangShadersDir)&quot; @(SlangSearchDir->'--search &quot;%(FullPath)&quot;', ' ') --out &quot;$(SlangOutDir)&quot;" />
    <Touch Files="$(SlangOutDir)/.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="CleanSlangAssets"
          AfterTargets="Clean"
          Condition="'$(SlangShadersDir)' != '' and Exists('$(SlangOutDir)')">
    <RemoveDir Directories="$(SlangOutDir)" />
  </Target>

  <Target Name="CopyPrecompiledSlang"
          AfterTargets="Build"
          Condition="'$(CopySlangAssets)' == 'true' and Exists('$(SlangOutDir)')">
    <ItemGroup>
      <_PrecompiledSlang Include="$(SlangOutDir)/*.json;$(SlangOutDir)/*.spv" />
    </ItemGroup>
    <Copy SourceFiles="@(_PrecompiledSlang)"
          DestinationFolder="$(OutDir)Shaders/Compiled"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishPrecompiledSlang"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(CopySlangAssets)' == 'true' and Exists('$(SlangOutDir)')">
    <ItemGroup>
      <_PrecompiledSlangPublish Include="$(SlangOutDir)/*.json;$(SlangOutDir)/*.spv" />
      <ResolvedFileToPublish Include="@(_PrecompiledSlangPublish)">
        <RelativePath>Shaders/Compiled/%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
