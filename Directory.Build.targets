<Project>

  <PropertyGroup>
    <SlangOutDir Condition="'$(SlangOutDir)' == ''">$(BaseIntermediateOutputPath)slang</SlangOutDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(GenerateSlang)' == 'true'">
    <SlangShaderRoot Include="$(SlangShaderDirs)" />
    <SlangSearchDir Include="$(SlangSearchDirs)" Condition="'$(SlangSearchDirs)' != ''" />
    <SlangGenerated Include="@(SlangShader->'$(SlangOutDir)/gen/%(Filename).g.cs')" />
    <SlangGenerated Include="$(SlangOutDir)/gen/ShaderModules.g.cs" />
    <Compile Include="@(SlangGenerated)" Link="Generated/%(Filename).g.cs" Visible="false" />
    <SlangInput Include="@(SlangShader)" />
    <SlangInput Include="@(SlangShaderRoot->'%(FullPath)/**/*.slang');@(SlangShaderRoot->'%(FullPath)/**/*.slangh')" />
  </ItemGroup>

  <Target Name="CollectSlangInputs" Condition="'$(GenerateSlang)' == 'true'">
    <CreateItem Include="@(SlangSearchDir->'%(FullPath)/**/*.slang');@(SlangSearchDir->'%(FullPath)/**/*.slangh')">
      <Output TaskParameter="Include" ItemName="SlangInput" />
    </CreateItem>
  </Target>

  <Target Name="ResolveSlangTool"
          Condition="'$(GenerateSlang)' == 'true'"
          DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="$(MSBuildThisFileDirectory)Pathetic.Renderer.Shaders.Generator/Pathetic.Renderer.Shaders.Generator.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_SlangTool" />
    </MSBuild>
  </Target>

  <Target Name="GenerateSlangAssets"
          Condition="'$(GenerateSlang)' == 'true'"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveSlangTool;CollectSlangInputs"
          Inputs="@(SlangInput);@(_SlangTool)"
          Outputs="$(SlangOutDir)/.stamp;@(SlangGenerated)">
    <RemoveDir Directories="$(SlangOutDir)/gen" />
    <ItemGroup>
      <_StaleSlangOutput Include="$(SlangOutDir)/*.spv" />
    </ItemGroup>
    <Delete Files="@(_StaleSlangOutput)" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(_SlangTool)&quot; @(SlangShaderRoot->'--shaders &quot;%(FullPath)&quot;', ' ') @(SlangSearchDir->'--search &quot;%(FullPath)&quot;', ' ') --out &quot;$(SlangOutDir)&quot;" />
    <Touch Files="$(SlangOutDir)/.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="EmbedSlangAssets"
          Condition="'$(EmbedSlangAssets)' == 'true'"
          BeforeTargets="PrepareResources"
          DependsOnTargets="GenerateSlangAssets">
    <ItemGroup>
      <_SlangSpirv Include="$(SlangOutDir)/*.spv" />
      <EmbeddedResource Include="@(_SlangSpirv)">
        <LogicalName>Pathetic.Renderer.Shaders.%(_SlangSpirv.Filename).spv</LogicalName>
        <Type>Non-Resx</Type>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="CleanSlangAssets"
          AfterTargets="Clean"
          Condition="'$(GenerateSlang)' == 'true' and Exists('$(SlangOutDir)')">
    <RemoveDir Directories="$(SlangOutDir)" />
  </Target>

</Project>
