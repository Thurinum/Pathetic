<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
        <RootNamespace>Pathetic.App</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pathetic.Renderer\Pathetic.Renderer.csproj" />
        <ProjectReference Include="..\Pathetic.SceneGraph\Pathetic.SceneGraph.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
        <PackageReference Include="NeoVeldrid" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.ImageSharp" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.ImGui" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.SPIRV" Version="1.2.1" />
        <PackageReference Include="NeoVeldrid.StartupUtilities" Version="1.2.1" />
        <PackageReference Include="Prowl.Slang" Version="3.7.2" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Pathetic.ini" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    
    <ItemGroup>
        <None Remove="Shaders/**/*" />
        <Content Include="Shaders/**/*">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
