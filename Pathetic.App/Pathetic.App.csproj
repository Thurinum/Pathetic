<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Pathetic.App</RootNamespace>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RuntimeIdentifier>$(NETCoreSdkPortableRuntimeIdentifier)</RuntimeIdentifier>
        <SelfContained>false</SelfContained>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Pathetic.Renderer.Shaders.GPUTypes" Alias="GPUTypes" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pathetic.Renderer.Shaders\Pathetic.Renderer.Shaders.csproj" />
        <ProjectReference Include="..\Pathetic.Renderer\Pathetic.Renderer.csproj" />
        <ProjectReference Include="..\Pathetic.SceneGraph\Pathetic.SceneGraph.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Ini" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Logging" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
        <PackageReference Include="NeoVeldrid" />
        <PackageReference Include="NeoVeldrid.ImageSharp" />
        <PackageReference Include="NeoVeldrid.ImGui" />
        <PackageReference Include="NeoVeldrid.SPIRV" />
        <PackageReference Include="NeoVeldrid.StartupUtilities" />
        <PackageReference Include="Silk.NET.Assimp" />
        <PackageReference Include="Ultz.Native.Assimp" />
    </ItemGroup>

    <ItemGroup>
        <None Update="Pathetic.ini" CopyToOutputDirectory="PreserveNewest" />
        <None Update="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
