<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Jitter2" Version="2.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
    <PackageVersion Include="NeoVeldrid" Version="1.2.1" />
    <PackageVersion Include="NeoVeldrid.ImageSharp" Version="1.2.1" />
    <PackageVersion Include="NeoVeldrid.ImGui" Version="1.2.1" />
    <PackageVersion Include="NeoVeldrid.SPIRV" Version="1.2.1" />
    <PackageVersion Include="NeoVeldrid.StartupUtilities" Version="1.2.1" />
    <PackageVersion Include="Prowl.Slang" Version="3.7.2" />
  </ItemGroup>

</Project>
