<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Pathetic.Shaders</RootNamespace>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
        <SlangShadersDir>$(MSBuildProjectDirectory)/Shaders</SlangShadersDir>
        <SlangOutDir>$(BaseIntermediateOutputPath)slang</SlangOutDir>
        <SlangToolPath>$(MSBuildThisFileDirectory)../Pathetic.Slang.Tool/bin/$(Configuration)/net11.0/Pathetic.Slang.Tool.dll</SlangToolPath>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <SlangShader Include="Shaders/**/*.slang" Exclude="Shaders/include/**" />
        <Content Include="Shaders/**/*" CopyToOutputDirectory="Always" />

        <SlangJson Include="@(SlangShader->'$(SlangOutDir)/%(Filename).json')" />
        <AdditionalFiles Include="@(SlangJson)" />

        <ProjectReference Include="..\Pathetic.Slang.Generator\Pathetic.Slang.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Pathetic.Slang.Tool\Pathetic.Slang.Tool.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    </ItemGroup>

    <Target Name="GenerateSlangAssets"
            BeforeTargets="CoreCompile"
            DependsOnTargets="ResolveProjectReferences"
            Inputs="@(SlangShader);$(SlangToolPath)"
            Outputs="@(SlangJson)">
        <Exec Command="dotnet &quot;$(SlangToolPath)&quot; --shaders &quot;$(SlangShadersDir)&quot; --out &quot;$(SlangOutDir)&quot;" />
    </Target>

</Project>
