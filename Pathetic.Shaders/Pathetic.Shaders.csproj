<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Pathetic.Shaders</RootNamespace>
        <SlangShadersDir>$(MSBuildProjectDirectory)/Shaders</SlangShadersDir>
        <SlangOutDir>$(BaseIntermediateOutputPath)slang</SlangOutDir>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Shaders/**/*.slang" CopyToOutputDirectory="PreserveNewest" />

        <ProjectReference Include="..\Pathetic.Slang.Tool\Pathetic.Slang.Tool.csproj"
                          ReferenceOutputAssembly="false"
                          Private="false"
                          GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    </ItemGroup>

    <Target Name="ResolveSlangTool" DependsOnTargets="ResolveProjectReferences">
        <MSBuild Projects="$(MSBuildThisFileDirectory)../Pathetic.Slang.Tool/Pathetic.Slang.Tool.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="RuntimeIdentifier;SelfContained">
            <Output TaskParameter="TargetOutputs" ItemName="_SlangTool" />
        </MSBuild>
    </Target>

    <Target Name="GenerateSlangAssets"
            BeforeTargets="CoreCompile"
            DependsOnTargets="ResolveSlangTool"
            Inputs="@(Content);@(_SlangTool)"
            Outputs="@(Content->'$(SlangOutDir)/%(Filename).json');@(Content->'$(SlangOutDir)/gen/%(Filename).g.cs');$(SlangOutDir)/gen/ResourceRefs.g.cs">
        <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;@(_SlangTool)&quot; --shaders &quot;$(SlangShadersDir)&quot; --out &quot;$(SlangOutDir)&quot;" />
    </Target>

    <Target Name="DeclareSlangSources"
            BeforeTargets="CoreCompile"
            DependsOnTargets="GenerateSlangAssets">
        <ItemGroup>
            <Compile Include="@(Content->'$(SlangOutDir)/gen/%(Filename).g.cs')" />
            <Compile Include="$(SlangOutDir)/gen/ResourceRefs.g.cs" />
        </ItemGroup>
    </Target>

</Project>
